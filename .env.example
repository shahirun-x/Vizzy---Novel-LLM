# Server-only credential used by the AI Story Director. Never prefix this with NEXT_PUBLIC.
OPENAI_API_KEY=

# Optional. Defaults to the current recommended text model documented by the app.
OPENAI_TEXT_MODEL=gpt-6-astra

# Required automatically on Vercel so a public deployment cannot spend the account freely.
# Enter this in Vizzy's AI form; it is sent per request and never persisted.
VIZZY_AI_ACCESS_CODE=
